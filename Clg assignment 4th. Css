body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #eef2f3;
}

.container {
    display: flex;
}

/* Sidebar */
.sidebar {
    width: 220px;
    background-color: #34495e;
    color: white;
    min-height: 100vh;
    padding: 20px;
}

.sidebar h2 {
    text-align: center;
}

.sidebar a {
    display: block;
    color: white;
    text-decoration: none;
    margin: 15px 0;
}

.sidebar a:hover {
    background-color: #2c3e50;
    padding-left: 10px;
}

/* Main Content */
.content {
    flex: 1;
    padding: 30px;
}

/* Hero Section */
.hero {
    background-color: #3498db;
    color: white;
    padding: 40px;
    text-align: center;
    border-radius: 5px;
}

/* Sections */
section {
    margin-top: 30px;
}

.course-box {
    display: flex;
    gap: 20px;
    margin-top: 15px;
}

.course {
    background-color: white;
    padding: 20px;
    flex: 1;
    text-align: center;
    border-radius: 5px;
    box-shadow: 0 0 8px rgba(0,0,0,0.1);
}

/* Footer */
footer {
    margin-top: 40px;
    text-align: center;
    color: #555;
}
