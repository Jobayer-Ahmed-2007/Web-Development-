body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    padding: 20px;
}

h1 {
    text-align: center;
}

section {
    background: white;
    padding: 15px;
    margin: 20px auto;
    width: 80%;
    border-radius: 5px;
}

img {
    display: block;
    margin: 10px auto;
}

form input {
    width: 100%;
    padding: 8px;
}

table {
    width: 100%;
    border-collapse: collapse;
}

table, th, td {
    border: 1px solid #333;
}

th, td {
    padding: 8px;
    text-align: center;
}

iframe {
    width: 700px;
    height: 200px;
    border: 1px solid #333;
}
